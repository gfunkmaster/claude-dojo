model Order {
  id         String   @id
  customerId String
  status     String
  totalOre   Int
  createdAt  DateTime @default(now())
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String
  amountOre Int
  createdAt DateTime @default(now())
}

model ProcessedEvent {
  eventId   String   @id
  service   String
  createdAt DateTime @default(now())
}
